# Retain private benchmark datasets and checkpoints locally.
.benchmark-local/
# Publish only inspectable benchmark tables; other CSVs remain ignored.
!results/benchmark/**/*.csv
# Large exact tables are published in a verified compressed evidence archive.
results/benchmark/**/splits.csv
results/benchmark/**/predictions.csv
results/benchmark/**/fit-ids.csv
results/benchmark/**/ros-lineage.csv
results/benchmark/**/preprocessing.json

# Publish the bounded GAN pilot using the same evidence-only policy.
!results/gan-research/**/*.csv
results/gan-research/**/splits.csv
results/gan-research/**/predictions.csv
results/gan-research/**/fit-ids.csv
results/gan-research/**/gan-fit-lineage.csv
results/gan-research/**/ros-lineage.csv
results/gan-research/**/preprocessing.json
